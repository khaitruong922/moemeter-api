{
	"name": "moemeter-api",
	"version": "0.0.1",
	"main": "src/index.ts",
	"private": true,
	"scripts": {
		"test": "jest --verbose",
		"deploy": "wrangler deploy",
		"dev": "bash -c 'export WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=$(grep \"^DATABASE_URL=\" .dev.vars | cut -d= -f2-); wrangler dev'",
		"dev:full-sync": "bash -c 'export WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=$(grep \"^DATABASE_URL=\" .dev.vars | cut -d= -f2-); wrangler dev --test-scheduled --var FORCE_FULL_SYNC:true'",
		"bookmeter": "cd ../bookmeter-api && wrangler dev",
		"start": "bash -c 'export WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=$(grep \"^DATABASE_URL=\" .dev.vars | cut -d= -f2-); wrangler dev'",
		"format": "prettier --write \"src/**/*.{ts,js,json}\"",
		"prepare": "git config core.hooksPath .githooks",
		"series:index": "esbuild scripts/series-scan/bw-index.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=scripts/series-scan/dist/bw-index.mjs && node scripts/series-scan/dist/bw-index.mjs",
		"series:scan": "esbuild scripts/series-scan/scan.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=scripts/series-scan/dist/scan.mjs && node scripts/series-scan/dist/scan.mjs",
		"series:apply": "esbuild scripts/series-scan/apply.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=scripts/series-scan/dist/apply.mjs && node scripts/series-scan/dist/apply.mjs",
		"series:render": "esbuild scripts/series-scan/render.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=scripts/series-scan/dist/render.mjs && node scripts/series-scan/dist/render.mjs",
		"series:sequels": "esbuild scripts/series-scan/sequels.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=scripts/series-scan/dist/sequels.mjs && node scripts/series-scan/dist/sequels.mjs",
		"series:daily": "npm run -s series:scan -- ../series-scan/bookwalker.sqlite ../series-scan && npm run -s series:sequels -- ../series-scan ../series-scan/bookwalker.sqlite && npm run -s series:render -- ../series-scan/candidates.json ../series-scan/review.html && open ../series-scan/review.html"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20240222.0",
		"@types/jest": "^29.5.12",
		"esbuild": "^0.27.2",
		"esbuild-jest": "^0.4.0",
		"jest": "^29.7.0",
		"jest-environment-miniflare": "^2.7.1",
		"miniflare": "^3.20240314.0",
		"prettier": "^3.6.2",
		"typescript": "^5.0.4",
		"wrangler": "^4.22.0"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.50.3",
		"hono": "^4.11.0",
		"postgres": "^3.4.7"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"description": ""
}
